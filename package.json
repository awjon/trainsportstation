{
  "name": "trainsportstation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A whimsical real-time 3D railroad puzzle game. Procedural asset generation.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.{ts,js}\"",
    "format": "prettier --write \"src/**/*.{ts,js}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
