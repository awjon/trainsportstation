{
  "name": "trainsportstation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A whimsical real-time 3D railroad puzzle game (Three.js + TypeScript + Kenney assets).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit-assets": "node scripts/audit-assets.mjs"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/three": "0.185.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
